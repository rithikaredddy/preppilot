# Copy to .env in this folder. Do not commit .env.

ENV_NAME=development
PORT=5001

# Docker Compose publishes Postgres on 5433 so it does not collide with another local database.
DATABASE_URL=postgresql+psycopg://interview:interview@localhost:5433/interview_prep

# Generate both with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string
JWT_SECRET=replace-with-a-long-random-string
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# Optional. When set, only these addresses can receive a TPO registration code.
# Leave empty during local development so any email can request a code.
TPO_ALLOWED_EMAILS=

# Local only. Returns the reset token in the API response when email is not configured.
# Keep false for any shared or production deployment.
PASSWORD_RESET_DEV_EXPOSE=false

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Optional. When SMTP_HOST is empty, development logs the reset link in the Flask terminal.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Language model used by the resume analyzer and interviews.
# Use anthropic, openai or gemini. Leave the key empty and those actions return a configuration error
# instead of a made-up score.
LLM_PROVIDER=anthropic
# Get a key at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high. Low keeps interview turns fast.
ANTHROPIC_EFFORT=low
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Resume uploads stay on this machine and are not committed.
UPLOAD_DIR=backend/uploads
MAX_UPLOAD_BYTES=5242880
